# Copy to .env for local development. Never commit your real credentials.
# Leave blank locally. In production, set the exact HTTPS website origin.
PUBLIC_ORIGIN=
CONTACT_PORT=8787
TRUST_PROXY=0

# A real sender address permitted by your SMTP provider and one recipient address.
CONTACT_FROM=
CONTACT_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
